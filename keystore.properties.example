# 复制为 keystore.properties 后填写，然后执行 ./gradlew app:assembleRelease
#
# 生成一个新的发布密钥（不要用仓库里公开的 test.key）：
#   keytool -genkeypair -v -keystore keystore/release.jks -alias ehviewer \
#           -keyalg RSA -keysize 2048 -validity 10000
#
# 注意：keystore.properties 已在 .gitignore 里，不要提交到仓库。

# 相对仓库根目录，或绝对路径
storeFile=keystore/release.jks
storePassword=在这里填库口令
keyAlias=ehviewer
keyPassword=在这里填密钥口令

# 也可以用环境变量覆盖（CI 用这种方式）：
#   EHVIEWER_KEYSTORE_FILE
#   EHVIEWER_KEYSTORE_PASSWORD
#   EHVIEWER_KEY_ALIAS
#   EHVIEWER_KEY_PASSWORD
